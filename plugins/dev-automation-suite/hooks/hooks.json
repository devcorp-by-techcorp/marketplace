{
  "$schema": "https://json.schemastore.org/claude-code-hooks.json",
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^(dev-automation-suite:)?code-(explorer|architect|reviewer)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/subagent-verification-gate.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
